{
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/data/**,backend/uploads/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/backend/(.*)", "destination": "/404" },
    { "source": "/uploads/(.*)", "destination": "/404" }
  ],
  "headers": [
    { "source": "/js/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/css/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}