{
  "version": 2,
  "build": {
    "env": {
      "CYPRESS_INSTALL_BINARY": "0"
    }
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["frontend/**", "backend/data/**"],
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}