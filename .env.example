# ============================================================
# Vitrina Digital Los Naranjos - Variables de Entorno
# Copia este archivo a ".env" y completa tus valores reales.
# ============================================================

PORT=4000
NODE_ENV=development

# URL pública de tu aplicación (para redirecciones de pagos)
# En producción (GoDaddy): https://tudominio.com
APP_URL=http://localhost:4000

# ============================================================
# WOMBI - Pasarela de Pagos (Colombia / COP)
# Deja VACÍO WOMPI_PUBLIC_KEY para usar el flujo simulado (dev).
# Obtén las llaves en https://comercios.wompi.co
# ------------------------------------------------------------
# Entorno: "sandbox" (pruebas) o "prod" (producción)
WOMPI_ENV=sandbox

# Llave pública de comercio. Ej:
#   Sandbox:    pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Producción: pub_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PUBLIC_KEY=

# Llave privada (solo backend, NUNCA exponer en frontend)
WOMPI_PRIVATE_KEY=

# Secreto de integridad (para firma del Widget Checkout)
#   Sandbox:    test_integrity_xxxxxxxxxxx
#   Producción: prod_integrity_xxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=

# Secreto de eventos (para verificar el checksum del webhook)
#   Sandbox:    test_events_xxxxxxxxxxx
#   Producción: prod_events_xxxxxxxxxxx
WOMPI_EVENTS_SECRET=

# ============================================================
# WHATSAPP (Meta Cloud API) - notificaciones automáticas
# Deja VACÍO para modo desarrollo (solo imprime en consola)
# ============================================================
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================
# ADMINISTRACIÓN - Login del panel admin (JWT)
# Cámbialas antes de subir a producción (GoDaddy).
# ============================================================
ADMIN_EMAIL=admin@losnaranjos.com
# Contraseña en texto plano: SOLO ÚSALA EN DESARROLLO.
# En producción genera un hash bcrypt (node scripts/hash-password.js <tu-clave>)
# y ponlo en ADMIN_PASSWORD_HASH. El login usará el hash, no la contraseña.
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=
# Secreto para firmar los tokens JWT. ¡CAMBIAR EN PRODUCCIÓN OBLIGATORIO!
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=los-naranjos-dev-secret-change-me

# ============================================================
# SOPORTE PARA EMPRENDEDORES (portada)
# WhatsApp con código de país, ej: 573001234567.
# Déjalos VACÍOS y el botón "CONTACTAR SOPORTE" mostrará solo el correo del admin.
# ============================================================
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# ============================================================
# ESTRUCTURA DEL CONJUNTO (configurable)
# Total de apartamentos del conjunto (por defecto 2160).
# Las torres se configuran en backend/data/towers.json
# ============================================================
TOTAL_APARTMENTS=2160
