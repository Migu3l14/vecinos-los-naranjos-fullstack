# ─── Desarrollo / Host clásico ───
PORT=4000
JWT_SECRET=cambiar-en-produccion
APP_URL=http://localhost:4000
NODE_ENV=development
SUPPORT_WHATSAPP=573001234501

# WhatsApp Cloud API (broadcast real). Vacío = modo demo (se imprime en consola).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Wompi (pagos). Vacíos = sandbox.
WOMPI_SANDBOX=true
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=

# ─── Volúmenes locales (Railway / VPS) ───
# Opcional: apunta los datos y uploads a un volumen montado.
# DATA_DIR=/data
# UPLOADS_DIR=/uploads

# ─── Vercel (despliegue cloud) ───
# Copia el proyecto a Vercel y define estas variables en el dashboard
# (Settings → Environment Variables). BLOB_READ_WRITE_TOKEN la genera Vercel solo.
# NODE_ENV=production
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=